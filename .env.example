# Supabase Database & Auth Variables
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (Server Actions & Admin verification only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# LLM Providers (Google Gemini as primary, Groq as fallback)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# Tavily AI Search Key (for syllabus & topic context augmentation)
TAVILY_API_KEY=your_tavily_api_key

# YouTube Data API v3 Key (for curating lecture videos)
YOUTUBE_API_KEY=your_youtube_api_key

